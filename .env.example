# Meta Model API (https://llama.developer.meta.com / https://dev.meta.ai)
# Bearer Token — OpenAI-SDK-kompatibel über base_url https://api.meta.ai/v1
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1

# Modell-IDs (vor erstem Call gegen /v1/models verifizieren)
MODEL_SPARK=muse-spark-1.3
MODEL_IMAGE=muse-image-1.0
MODEL_SAM=sam-3.1

# Open Weights (Bonuspreis): Muse Spark Open über Baseten Model APIs (OpenAI-kompatibel)
# Key: https://app.baseten.co/settings/api_keys
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
MODEL_SPARK_OPEN=meta-models/muse-spark-open-1026
# 0 = alles hosted (muse-spark-1.3) · 1 = nur Vision-Pässe auf Muse Spark Open · all = ganzer Agent auf Open Weights (Standard für Demo)
OPEN_WEIGHTS=all

# Kostenschutz für die öffentliche Demo (pro Server-Instanz; 0 = aus)
RUNS_PER_IP_PER_HOUR=5
RUNS_PER_DAY=100
